# ── EcoFlow Monitor — Environment Variables ───────────────────────────
# Copy this file to .env and adjust values for your deployment.
#   cp .env.example .env

# Server port (default: 3000)
PORT=3000

# Runtime environment: "production" or "development"
# In production, the server serves the built frontend from dist/.
NODE_ENV=production

# JWT secret for API authentication tokens.
# If left empty, a random 64-byte secret is auto-generated and persisted
# in the database on first startup — no action needed.
# JWT_SECRET=

# MQTT credentials for EcoFlow cloud — used to auto-refresh the MQTT
# certificate when it expires. Required if your EcoFlow devices use
# MQTT communication via the EcoFlow cloud broker.
# ECOFLOW_EMAIL=
# ECOFLOW_PASSWORD=
